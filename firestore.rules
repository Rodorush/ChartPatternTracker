rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura só com login. Nenhuma escrita pelo cliente: quem grava é a
    // Cloud Function, pelo Admin SDK, que não passa por estas regras.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

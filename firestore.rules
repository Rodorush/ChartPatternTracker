rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura com login, só nas coleções que o app lê. Nenhuma escrita pelo
    // cliente: quem grava é a Cloud Function, pelo Admin SDK, que não passa
    // por estas regras. O que não casa abaixo é negado, como `rate_limits`,
    // que guarda a cota de chamadas de cada usuário.
    match /candlesticks/{ticker}/{timeframe}/{candle} {
      allow read: if request.auth != null;
    }

    match /candlestick_patterns/{pattern} {
      allow read: if request.auth != null;
    }

    match /assets/{ticker} {
      allow read: if request.auth != null;
    }
  }
}
